-- BiteTest v1.7 (Dino Arcade) — TEST input for the quick bite. Left click (mouse), R2 (gamepad) or the
-- on-screen Bite button (touch).
-- On press (when allowed): stamps BitePredictedAt = server time (this client only, so the attacker sees the
-- wind-up at once), sends DinoBiteRequest:FireServer(that time), and pushes the body forward
-- BiteLungeDist studs during the strike (BiteWindup .. BiteWindup + BiteStrike), stopping at walls.
-- Not allowed (no request, no prediction): while Roaring, while dead, BiteEnabled = false, or within
-- BiteCooldown of the last local bite (the server checks the same cooldown).
-- v1.1: hit claim. At the contact moment (BiteWindup + BiteStrike after the press) this client checks the
--   bite against what it actually shows: a capsule of radius BiteRange around the line from BiteReachBack
--   studs behind the animated mouth (Head_mouth front face, back along the snout) to BiteRange / 2 studs
--   ahead of it, so a target the head has pushed into still counts. The closest BiteDummy part found is
--   sent as DinoBiteClaim:FireServer(stamp, targetModel, point); BiteServer validates it. No target = no claim.
-- v1.2: targets are BiteDummy models (any part) and Bitable models such as other dinos (only their
--   per-body-part hitboxes, folder "Hitboxes", built by DinoHitboxes).
-- v1.3: bite dip (user: "a raptor can be directly in front of me yet be unbitable" — the T-Rex mouth is ~13 studs up).
--   At the press this client looks for the smallest downward swing of the mouth about the neck (0 .. BiteDipMax 60
--   degrees, 5-degree steps) that brings the capsule tip (BiteRange / 2 ahead of the mouth front) within BiteRange of
--   a hitbox of another Bitable dino (not knocked out); 0 when one is already in reach or none is found. The angle
--   goes with the request (DinoBiteRequest:FireServer(stamp, dip)), is shown at once as BiteDipPredicted (IdleAnimation
--   1.18 / BitePose 1.1 lower the head) and the contact claim's capsule is tilted down by it too.
--   Diagnostic: BiteDipChosen (degrees).
-- v1.4: dip by the whole capsule (user: "when a raptor is directly in front of me yet beneath me i can't do anything
--   about it"). v1.3 scored a dip by the capsule TIP only, but the hit (this client's claim and BiteServer's own check)
--   uses the whole capsule: BiteReachBack studs behind the mouth front to BiteRange / 2 ahead, radius BiteRange. The tip
--   swings on a ~16.8-stud arc about the neck and never comes closer than ~15.8 studs ahead of the T-Rex's centre, so a
--   raptor standing just in front of the chest (~8.5-11 studs ahead) got dip 0 and the level bite passed over it, even
--   though a dipped capsule reaches it. Now each dip (same 0 .. BiteDipMax steps, smallest first) is scored by the
--   distance from the target hitboxes to the whole rotated segment (a .. tip), exactly what BiteServer 1.5 checks
--   (rest-pose segment rotated about the neck). Any dip v1.3 found is still found (the tip is the segment's end), possibly
--   smaller. Diagnostic: BiteDipProbe ("capsule" = v1.4 scoring).
-- v1.5: auto-aim (user: "the t-rex bite isnt consistent enough. i can have raptors laying right in front of me and i
--   bite and it misses"; answers: auto-aim each bite, +-45 degree cone). The bite only dipped, never turned: its reach was
--   about +-6 studs either side of the centre line, and the dip chosen was the smallest that just reached (the capsule's
--   edge), so a small shift during the 0.25 s wind-up + strike or the 3-stud lunge made it miss. Now at the press
--   (BiteAimAssist ~= false) every hitbox of every other bitable dino / bite dummy (not knocked out, HumanoidRootPart
--   within AIM_SCAN studs: Workspace children and DinoIsland.Bots) whose point nearest the mouth lies within
--   BiteAimCone (45) degrees of the body's facing (flat, from the HumanoidRootPart) is tried: yaw = the flat angle from
--   the facing to that point seen from the neck (clamped to +-BiteAimMax 45, positive = left), then the dip (0 ..
--   BiteDipMax in DIP_STEP steps) that brings the capsule (dipped about the neck, then turned by yaw about the vertical
--   through the neck: what BiteServer 1.7 checks) closest to the hitbox (smallest gap, not the smallest dip). Hitboxes
--   with a gap <= BiteRange compete on score = gap + AIM_YAW_WEIGHT x |yaw| + AIM_DIST_WEIGHT x distance; the best one
--   is the aim: DinoBiteRequest:FireServer(stamp, dip, yaw, targetModel); BiteDipPredicted / BiteAimYawPredicted
--   (the head turns at once, BitePose 1.2); the lunge goes along the aimed direction; the contact claim's capsule is
--   dipped and turned the same way. No hitbox in reach: the v1.4 dip choice (yaw 0, no target).
--   Diagnostics: BiteAimTarget (model name / ""), BiteAimGap (studs, 0.1 steps), BiteAimYawChosen, BiteTestVersion.
-- v1.6 (prey, DINO-14): auto-aim also tries the prey in DinoIsland.Prey (PreyServer 1.0: compies, chickens, crabs);
--   the scoring and everything else in the aim are unchanged.
-- Diagnostics (character attributes, this client): BiteClaim ("sent" / "none"), BiteInputResult ("sent" / "cooldown" / "roaring" /
--   "disabled" / "dead"), BiteLungeMoved (studs actually moved by the last lunge, 0.01 steps).
-- v1.7 (Arena squads, MDA-160, plan docs/plans/SQUADS_v1.0.md Task S3, ADR-006; Kepu 2026-10-31 "turning friendly fire off"): a squadmate's hitboxes are not a bite target (targetOf) and
--   not an aim-assist candidate (aimCandidates), so the bite never steers onto or claims a squadmate.
--   Squadmates = ReplicatedStorage.SquadShared.SquadRules (SquadServer 1.0's copy) sameChar. Switch: script attribute
--   BiteTestSquadEnabled (default true, read at each check; false = 1.6).
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local char = script.Parent
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local remote = ReplicatedStorage:WaitForChild("DinoBiteRequest")
local claimRemote = ReplicatedStorage:WaitForChild("DinoBiteClaim")

local ACTION = "DinoBiteTest"
local DEFAULTS = {BiteEnabled = true, BiteCooldown = 0.8, BiteWindup = 0.15, BiteStrike = 0.10, BiteLungeDist = 3,
	BiteRange = 5, BiteReachBack = 8, BiteDipMax = 60, -- v1.3: BiteDipMax
	BiteAimAssist = true, BiteAimCone = 45, BiteAimMax = 45} -- v1.5
local DIP_STEP = 5 -- v1.3: degrees between tried dips
local AIM_SCAN, AIM_YAW_WEIGHT, AIM_DIST_WEIGHT = 45, 0.05, 0.02 -- v1.5
char:SetAttribute("BiteTestVersion", "1.7")

local function get(k)
	local v = char:GetAttribute(k)
	if v == nil then v = DEFAULTS[k] end
	return v
end

local lastBite = -math.huge
local lungeConn

-- moves the body forward `dist` studs over `duration` seconds, starting after `delay` seconds
local function lunge(delay, duration, dist, yaw) -- v1.5: + yaw (degrees, the aimed direction)
	if lungeConn then lungeConn:Disconnect(); lungeConn = nil end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local t0 = os.clock()
	local moved = 0
	lungeConn = RunService.PreSimulation:Connect(function()
		local t = os.clock() - t0 - delay
		if t < 0 then return end
		local target = dist * math.clamp(t / duration, 0, 1)
		local step = target - moved
		if step > 0 then
			local fwd = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
			if fwd.Magnitude > 1e-3 then
				fwd = fwd.Unit
				if yaw and yaw ~= 0 then fwd = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(yaw)):VectorToWorldSpace(fwd) end -- v1.5
				-- stop at walls: probe from the body centre to just past the front of the hitbox
				local probe = hrp.Size.Z / 2 + step + 0.5
				if not workspace:Raycast(hrp.Position, fwd * probe, params) then
					hrp.CFrame = hrp.CFrame + fwd * step
					moved += step
				else
					t = duration -- blocked: end the lunge here
				end
			end
		end
		if t >= duration then
			char:SetAttribute("BiteLungeMoved", math.floor(moved * 100 + 0.5) / 100)
			lungeConn:Disconnect()
			lungeConn = nil
		end
	end)
end

-- closest point of a part's box to p
local function closestPoint(part, p)
	local lp = part.CFrame:PointToObjectSpace(p)
	local h = part.Size / 2
	return part.CFrame * Vector3.new(math.clamp(lp.X, -h.X, h.X), math.clamp(lp.Y, -h.Y, h.Y), math.clamp(lp.Z, -h.Z, h.Z))
end

-- the bite target a part belongs to: a BiteDummy model (any of its parts) or a Bitable model (only the
-- parts in its "Hitboxes" folder, built by DinoHitboxes); nil otherwise
-- v1.7: squadmates are never targets (ReplicatedStorage.SquadShared.SquadRules, loaded on first use)
local squadMod
local function squadmate(a, b)
	if script:GetAttribute("BiteTestSquadEnabled") == false then return false end
	if not squadMod then
		local sh = game:GetService("ReplicatedStorage"):FindFirstChild("SquadShared")
		local m = sh and sh:FindFirstChild("SquadRules")
		if not m then return false end
		local ok, mod = pcall(require, m)
		if not ok then return false end
		squadMod = mod
	end
	return squadMod.sameChar(a, b)
end
local function targetOf(part)
	local model = part:FindFirstAncestorWhichIsA("Model")
	while model do
		if model:GetAttribute("BiteDummy") == true then return model end
		if model:GetAttribute("Bitable") == true then
			local folder = part.Parent
			if folder and folder.Name == "Hitboxes" and folder.Parent == model then
				if squadmate(char, model) then return nil end -- v1.7
				return model
			end
			return nil
		end
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end

-- closest distance (and point on the part) between a part's box and the segment a..b, sampled every 0.5 studs
local function segmentHit(part, a, b)
	local best, bestPt = math.huge, nil
	local n = math.max(1, math.ceil((b - a).Magnitude / 0.5))
	for i = 0, n do
		local q = a:Lerp(b, i / n)
		local cp = closestPoint(part, q)
		local d = (cp - q).Magnitude
		if d < best then best, bestPt = d, cp end
	end
	return best, bestPt
end

-- v1.3: the downward swing (degrees) that brings the bite onto the nearest low dino in front; 0 if none
local function chooseDip()
	local head = char:FindFirstChild("Head")
	local mouth = head and head:FindFirstChild("Head_mouth")
	local neck = char:FindFirstChild("Neck")
	local pivotPart = neck and neck:FindFirstChild("Root")
	local fwd = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	if not (mouth and pivotPart) or fwd.Magnitude < 1e-3 then return 0 end
	fwd = fwd.Unit
	local range = get("BiteRange")
	local pivot = pivotPart.Position
	local tip0 = mouth.CFrame * Vector3.new(mouth.Size.X / 2, 0, 0) + fwd * (range / 2)
	local back0 = mouth.CFrame * Vector3.new(mouth.Size.X / 2, 0, 0) - fwd * get("BiteReachBack") -- v1.4: capsule rear
	local right = fwd:Cross(Vector3.yAxis)
	local parts = {}
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model") and m ~= char and m:GetAttribute("Bitable") == true and m:GetAttribute("DummyState") ~= "ko" then
			local hb = m:FindFirstChild("Hitboxes")
			local mhrp = m:FindFirstChild("HumanoidRootPart")
			if hb and mhrp and (mhrp.Position - pivot).Magnitude < 60 then
				for _, p in ipairs(hb:GetChildren()) do
					if p:IsA("BasePart") then table.insert(parts, p) end
				end
			end
		end
	end
	if #parts == 0 then return 0 end
	for deg = 0, get("BiteDipMax"), DIP_STEP do
		local rot = CFrame.fromAxisAngle(right, -math.rad(deg))
		local tip = pivot + rot:VectorToWorldSpace(tip0 - pivot)
		local back = pivot + rot:VectorToWorldSpace(back0 - pivot) -- v1.4
		for _, p in ipairs(parts) do
			if segmentHit(p, back, tip) <= range then -- v1.4: whole capsule (v1.3: tip only)
				char:SetAttribute("BiteDipProbe", "capsule")
				return deg
			end
		end
	end
	return 0
end

-- v1.5: auto-aim (see the header); returns {model, part, dip, yaw, gap} or nil
local function aimCandidates()
	local list = {}
	local function consider(m)
		if not m:IsA("Model") or m == char or m:GetAttribute("DummyState") == "ko" then return end
		if squadmate(char, m) then return end -- v1.7
		local h = m:FindFirstChildOfClass("Humanoid")
		if h and h.Health <= 0 then return end
		if m:GetAttribute("BiteDummy") == true then
			table.insert(list, {model = m, container = m})
		elseif m:GetAttribute("Bitable") == true and m:FindFirstChild("Hitboxes") then
			table.insert(list, {model = m, container = m.Hitboxes})
		end
	end
	for _, m in ipairs(workspace:GetChildren()) do consider(m) end
	local isl = workspace:FindFirstChild("DinoIsland")
	local bots = isl and isl:FindFirstChild("Bots")
	if bots then for _, m in ipairs(bots:GetChildren()) do consider(m) end end
	local prey = isl and isl:FindFirstChild("Prey") -- v1.6
	if prey then for _, m in ipairs(prey:GetChildren()) do consider(m) end end
	return list
end

local function flatAngle(from, to) -- signed degrees from `from` to `to` about +Y (positive = left)
	local a = math.atan2(from.X * to.Z - from.Z * to.X, from.X * to.X + from.Z * to.Z)
	return -math.deg(a)
end

local function chooseAim()
	local head = char:FindFirstChild("Head")
	local mouth = head and head:FindFirstChild("Head_mouth")
	local neck = char:FindFirstChild("Neck")
	local pivotPart = neck and neck:FindFirstChild("Root")
	local fwd = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	if not (mouth and pivotPart) or fwd.Magnitude < 1e-3 then return nil end
	fwd = fwd.Unit
	local range, cone, aimMax = get("BiteRange"), get("BiteAimCone"), get("BiteAimMax")
	local pivot = pivotPart.Position
	local origin = mouth.CFrame * Vector3.new(mouth.Size.X / 2, 0, 0)
	local tip0, back0 = origin + fwd * (range / 2), origin - fwd * get("BiteReachBack")
	local right = fwd:Cross(Vector3.yAxis)
	local best
	for _, c in ipairs(aimCandidates()) do
		local ref = c.model:FindFirstChild("HumanoidRootPart")
		local refPos = ref and ref.Position or c.model:GetPivot().Position
		if (refPos - hrp.Position).Magnitude <= AIM_SCAN then
			for _, part in ipairs(c.container:GetDescendants()) do
				if part:IsA("BasePart") then
					local P = closestPoint(part, origin)
					local toP = Vector3.new(P.X - hrp.Position.X, 0, P.Z - hrp.Position.Z)
					if toP.Magnitude > 1e-3 and math.abs(flatAngle(fwd, toP)) <= cone then
						local toPivot = Vector3.new(P.X - pivot.X, 0, P.Z - pivot.Z)
						local yaw = toPivot.Magnitude > 1e-3 and math.clamp(flatAngle(fwd, toPivot), -aimMax, aimMax) or 0
						local rotY = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(yaw))
						local gap, dip = math.huge, 0
						for deg = 0, get("BiteDipMax"), DIP_STEP do
							local rot = CFrame.fromAxisAngle(right, -math.rad(deg))
							local tip = pivot + rotY:VectorToWorldSpace(rot:VectorToWorldSpace(tip0 - pivot))
							local back = pivot + rotY:VectorToWorldSpace(rot:VectorToWorldSpace(back0 - pivot))
							local g = segmentHit(part, back, tip)
							if g < gap - 0.05 then gap, dip = g, deg end
						end
						if gap <= range then
							local score = gap + AIM_YAW_WEIGHT * math.abs(yaw) + AIM_DIST_WEIGHT * toP.Magnitude
							if not best or score < best.score then
								best = {model = c.model, part = part, dip = dip, yaw = yaw, gap = gap, score = score}
							end
						end
					end
				end
			end
		end
	end
	return best
end

-- at the contact moment: find the closest target part around the animated snout and claim it
local function claimHit(stamp, dip, yaw) -- v1.5: + yaw
	local head = char:FindFirstChild("Head")
	local mouth = head and head:FindFirstChild("Head_mouth")
	if not mouth then return end
	local origin = mouth.CFrame * Vector3.new(mouth.Size.X / 2, 0, 0)
	local fwd = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	if fwd.Magnitude < 1e-3 then return end
	local range = get("BiteRange")
	fwd = fwd.Unit
	if dip and dip > 0 then -- v1.3: capsule tilted down with the head
		fwd = CFrame.fromAxisAngle(fwd:Cross(Vector3.yAxis), -math.rad(dip)):VectorToWorldSpace(fwd)
	end
	if yaw and yaw ~= 0 then -- v1.5: turned toward the aimed target
		fwd = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(yaw)):VectorToWorldSpace(fwd)
	end
	local a, b = origin - fwd * get("BiteReachBack"), origin + fwd * (range / 2)
	local params = OverlapParams.new()
	params.FilterDescendantsInstances = {char}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local best, bestModel, bestPoint = math.huge, nil, nil
	for _, part in ipairs(workspace:GetPartBoundsInRadius((a + b) / 2, (b - a).Magnitude / 2 + range, params)) do
		local model = targetOf(part)
		if model then
			local d, cp = segmentHit(part, a, b)
			if d <= range and d < best then best, bestModel, bestPoint = d, model, cp end
		end
	end
	if bestModel then
		claimRemote:FireServer(stamp, bestModel, bestPoint)
		char:SetAttribute("BiteClaim", "sent")
	else
		char:SetAttribute("BiteClaim", "none")
	end
end

local function tryBite()
	local result
	if hum.Health <= 0 then
		result = "dead"
	elseif get("BiteEnabled") == false then
		result = "disabled"
	elseif char:GetAttribute("Roaring") then
		result = "roaring"
	elseif os.clock() - lastBite < get("BiteCooldown") then
		result = "cooldown"
	else
		result = "sent"
		lastBite = os.clock()
		local stamp = workspace:GetServerTimeNow()
		local aim = get("BiteAimAssist") ~= false and chooseAim() or nil -- v1.5
		local dip, yaw, target = 0, 0, nil
		if aim then
			dip, yaw, target = aim.dip, aim.yaw, aim.model
		else
			dip = chooseDip() -- v1.3
		end
		yaw = math.floor(yaw * 10 + 0.5) / 10
		char:SetAttribute("BiteAimTarget", target and target.Name or "")
		char:SetAttribute("BiteAimGap", aim and math.floor(aim.gap * 10 + 0.5) / 10 or -1)
		char:SetAttribute("BiteAimYawChosen", yaw)
		char:SetAttribute("BiteDipChosen", dip)
		char:SetAttribute("BiteDipPredicted", dip)
		char:SetAttribute("BiteAimYawPredicted", yaw)
		char:SetAttribute("BitePredictedAt", stamp)
		remote:FireServer(stamp, dip, yaw, target)
		lunge(get("BiteWindup"), get("BiteStrike"), get("BiteLungeDist"), yaw)
		task.delay(get("BiteWindup") + get("BiteStrike"), claimHit, stamp, dip, yaw)
	end
	char:SetAttribute("BiteInputResult", result)
end

local function onBite(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		tryBite()
	end
	return Enum.ContextActionResult.Pass -- let clicks still reach the rest of the game (camera, UI)
end

ContextActionService:BindActionAtPriority(ACTION, onBite, true, Enum.ContextActionPriority.High.Value,
	Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
ContextActionService:SetTitle(ACTION, "Bite")

local function cleanup()
	ContextActionService:UnbindAction(ACTION)
	if lungeConn then lungeConn:Disconnect(); lungeConn = nil end
end
hum.Died:Connect(cleanup)
char.AncestryChanged:Connect(function(_, parent)
	if not parent then cleanup() end
end)
